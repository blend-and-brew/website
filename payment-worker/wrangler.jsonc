{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blend-brew-payment-worker",
  "main": "payment-worker.js",
  "compatibility_date": "2026-08-31",

  "routes": [
    {
      "pattern": "www.blendandbrew.com.au/api/pay/*",
      "zone_name": "blendandbrew.com.au"
    },
    {
      "pattern": "cogs.blendandbrew.com.au/api/pay/*",
      "zone_name": "blendandbrew.com.au"
    }
  ],

  "kv_namespaces": [
    { "binding": "ORDERS", "id": "43f2fb3acc5b49aca71532206bea8515" }
  ],

  "vars": {
    "SQUARE_ENV": "production",
    "SQUARE_LOCATION_ID": "LXCYAQP5MB9YG",
    "SQUARE_APPLICATION_ID": "sq0idp-K-ujSIU2RU6xP_CKwN4foA"
  }
}
