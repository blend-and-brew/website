{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blend-brew-payment-worker",
  "main": "payment-worker.js",
  "compatibility_date": "2026-08-31",

  // This binds the worker to www.blendandbrew.com.au/payment specifically —
  // matches the "website" worker's existing www.blendandbrew.com.au/*
  // wildcard route. Cloudflare matches the more specific route pattern
  // first, so this /payment path routes here while everything else on
  // www.blendandbrew.com.au/* continues to the "website" worker as before.
  "routes": [
    {
      "pattern": "www.blendandbrew.com.au/payment",
      "zone_name": "blendandbrew.com.au"
    }
  ]

  // Note: SQUARE_ACCESS_TOKEN is NOT set here — it's a secret, added
  // via `wrangler secret put SQUARE_ACCESS_TOKEN` after first deploy,
  // never committed to this file or version control.
}
