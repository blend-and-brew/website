{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "website",
  "compatibility_date": "2026-08-15",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
